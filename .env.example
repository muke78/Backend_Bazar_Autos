PORT=3000
NODE_ENV=development

# Base de datos
# ⚠️  DB_USER NO puede ser "root" en Docker — MySQL image lo rechaza
# Usa cualquier otro nombre: bazar_user, app_user, etc.
DB_HOST=localhost
DB_USER=bazar_user
DB_PASS=pass
DB_NAME=bazar_autos
DB_PORT=3306

# Ambiente de trabajo
RUNTIME=local

# Autenticacion
JWT_SECRET=secret
JWT_SECRET_EXPAND=secret_refresh

# Tokens
JWT_EXPIRES_IN=time
JWT_REFRESH_EXPIRES_IN=time

# Cookies
JWT_EXPIRES_COOKIE=time
JWT_REFRESH_EXPIRES_COOKIE=time

# Otros
LOG_LEVEL=debug
API_VERSION=v1
BASE_URL_SWAGGER=http://localhost:3000/api/docs/
