PORT=3000
# NODE_ENV=production
NODE_ENV=development

# Base de datos
DB_HOST=localhost
DB_USER=user
DB_PASS=pass
DB_NAME=bd_name
DB_PORT=3306

# Ambiente de trabajo
RUNTIME=local

# Autenticacion
JWT_SECRET=secret
JWT_SECRET_EXPAND=secret_refresh

# Tokens
JWT_EXPIRES_IN=time
JWT_REFRESH_EXPIRES_IN=time

# Cookies
JWT_EXPIRES_COOKIE=time
JWT_REFRESH_EXPIRES_COOKIE=time

# Otros
LOG_LEVEL=debug
API_VERSION=v1
BASE_URL_SWAGGER=http://localhost:3000/api/docs/