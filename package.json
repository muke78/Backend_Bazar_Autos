{
	"name": "backend_bazar_autos",
	"version": "1.0.0",
	"description": "Sistema para un bazar de autos y control de flujo de dinero",
	"main": "index.js",
	"type": "module",
	"scripts": {
		"start": "node index.js",
		"start:cluster": "node cluster.js",
		"start:prod": "cross-env NODE_ENV=production node --max-old-space-size=512 cluster.js",
		"dev": "nodemon index.js",
		"loadtest:root": "node scripts/loadtest.js root",
		"loadtest:dashboard": "node scripts/loadtest.js dashboard",
		"loadtest:reports": "node scripts/loadtest.js reports",
		"perf:doctor": "clinic doctor -- node index.js",
		"perf:flame": "clinic flame -- node index.js",
		"format": "pnpm exec biome format --write .",
		"lint": "pnpm exec biome lint --write .",
		"check:biome": "pnpm exec biome check --write ."
	},
	"keywords": [
		"node",
		"express",
		"api",
		"backend",
		"mysql",
		"swagger"
	],
	"author": "Erick Gobzalez, Osvaldo Cabrera",
	"license": "ISC",
	"packageManager": "pnpm@10.33.3",
	"dependencies": {
		"argon2": "0.44.0",
		"compression": "^1.7.5",
		"cookie-parser": "1.4.7",
		"cors": "2.8.6",
		"dotenv": "17.3.1",
		"ejs": "^5.0.2",
		"exceljs": "^4.4.0",
		"express": "5.2.1",
		"express-rate-limit": "8.2.1",
		"express-status-monitor": "^1.3.4",
		"helmet": "8.1.0",
		"joi": "18.0.2",
		"jsonwebtoken": "9.0.3",
		"morgan": "1.10.1",
		"mysql2": "3.18.2",
		"puppeteer-core": "^25.0.4",
		"swagger-themes": "1.4.3",
		"swagger-ui-express": "5.0.1",
		"winston": "3.19.0",
		"yamljs": "0.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.4",
		"autocannon": "^8.0.0",
		"cross-env": "^10.1.0",
		"nodemon": "3.1.14"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@scarf/scarf",
			"argon2",
			"event-loop-stats"
		]
	}
}
